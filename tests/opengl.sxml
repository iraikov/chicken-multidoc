(wiki-page
 (Header (title "OpenGL"))
 (body
  (section
   2
   "opengl"
   (toc)
   (section 3 "Description" (p "Bindings for the OpenGL API."))
   (section
    3
    "Author"
    (p (int-link "/users/felix winkelmann" "felix winkelmann")))
   (section
    3
    "Requirements"
    (ul (li (int-link "silex")) (li (int-link "easyffi"))))
   (section
    3
    "Download"
    (p (link "http://www.call-with-current-continuation.org/eggs/opengl.egg"
             "opengl.egg")))
   (section
    3
    "Documentation"
    (p "To use the GL and GLU extensions, load them:")
    (pre " (require-extension gl)
 (require-extension glu)")
